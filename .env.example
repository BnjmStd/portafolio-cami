# Contraseña del panel de administración
# Cámbiala por una contraseña segura antes de deploy
ADMIN_PASSWORD=cambia-esta-contraseña

# Secreto para firmar los tokens de sesión (mínimo 32 caracteres aleatorios)
SESSION_SECRET=genera-un-secreto-aleatorio-seguro-aqui

# Opcional: ruta absoluta a la carpeta data/ en producción
# DATA_DIR=/ruta/absoluta/a/data
