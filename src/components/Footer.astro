---
import Github from "~/icons/Github.astro";
import Linkdn from "~/icons/Linkdn.astro";

const currentNameCompany =
  "Servicios Informáticos Valenzuela, Astudillo y Compañía Limitada";
---

<footer class="footer">
  <div class="footer-container">
    <div class="footer-content">
      <div class="footer-links">
        <a href="https://www.linkedin.com/in/camila-diaz690">
          <Linkdn />
        </a>
        <a href="#">
          <Github />
        </a>
      </div>
      <p class="footer-text">
        © 2025 {currentNameCompany}. All rights reserved.
      </p>
    </div>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--color-border);
    background-color: var(--color-bg);
    transition:
      background-color 0.3s ease,
      border-color 0.3s ease;
  }

  .footer-container {
    max-width: 1280px;
    margin-left: auto;
    margin-right: auto;
    padding: 2.5rem 1.25rem;
  }

  .footer-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
  }

  .footer-links {
    display: flex;
    justify-content: center;
    gap: 1.5rem;
  }

  .footer-links a {
    color: var(--color-text-muted);
    transition: color 0.2s ease-in-out;
  }

  .footer-links a:hover {
    color: var(--primary);
  }

  .footer-text {
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }
</style>
