---
import SectionAndTitle from "./SectionAndTitle.astro";

const projects = [
  {
    image: "/projects/tesis_cami.jpg",
    title: "Memoria de título",
    description:
      "PROPUESTA DE MEJORA CONSTRUCTIVA CON LA METODOLOGÍA BIM, PARA VIVIENDAS UNIFAMILIARES DE LA CONSTRUCTORA COLBÚN SPA",
    slug: "project1",
  },
  {
    image: "/projects/project2.jpg",
    title: "Proyecto 2",
    description: "Descripción del proyecto 2, un caso de estudio interesante.",
    slug: "project2",
  },
  {
    image: "/projects/project3.jpg",
    title: "Proyecto 3",
    description: "Descripción del proyecto 3, otro ejemplo de trabajo.",
    slug: "project3",
  },
  {
    image: "/projects/project4.jpg",
    title: "Proyecto 4",
    description: "Descripción del proyecto 4, muestra adicional.",
    slug: "project4",
  },
  {
    image: "/projects/project5.jpg",
    title: "Proyecto 5",
    description: "Descripción del proyecto 5, última muestra.",
    slug: "project5",
  },
];
---

<SectionAndTitle title="Projects">
  <div class="project-carousel-wrapper">
    <div class="project-carousel-track" id="project-track">
      {
        projects.map((p) => (
          <a href={`/blog/${p.slug}`} class="project-card">
            <div
              class="project-image"
              style={`background-image: url(${p.image});`}
            />
            <div class="project-content">
              <h3 class="project-title">{p.title}</h3>
              <p class="project-description">{p.description}</p>
            </div>
          </a>
        ))
      }
    </div>

    <div class="project-nav">
      <button class="project-nav-btn" id="project-prev" aria-label="Previous">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"><path d="M15 18l-6-6 6-6"></path></svg
        >
      </button>
      <button class="project-nav-btn" id="project-next" aria-label="Next">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"><path d="M9 18l6-6-6-6"></path></svg
        >
      </button>
    </div>
  </div>
</SectionAndTitle>

<style>
  .project-carousel-wrapper {
    width: 100%;
    overflow: hidden;
    padding: 2rem 0;
    perspective: 1200px;
  }

  .project-carousel-track {
    display: flex;
    gap: 2rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding: 2rem calc(50vw - 40vw) 2rem calc(50vw - 40vw);
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .project-carousel-track::-webkit-scrollbar {
    display: none;
  }

  @media (min-width: 768px) {
    .project-carousel-track {
      padding-left: calc(50vw - 250px);
      padding-right: calc(50vw - 250px);
    }
  }

  .project-card {
    flex: 0 0 80vw;
    max-width: 500px;
    scroll-snap-align: center;
    display: flex;
    flex-direction: column;
    background: var(--color-card-bg);
    border-radius: 1rem;
    overflow: hidden;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
    transition:
      transform 0.6s ease,
      opacity 0.6s ease;
    transform: perspective(1200px) rotateY(25deg) scale(0.85);
    opacity: 0.6;
    text-decoration: none;
    color: inherit;
  }

  .project-card.active {
    transform: perspective(1200px) rotateY(0deg) scale(1);
    opacity: 1;
  }

  .project-card:hover {
    box-shadow: 0 15px 40px rgba(0, 0, 0, 0.3);
  }

  @media (min-width: 768px) {
    .project-card {
      flex: 0 0 500px;
    }
  }

  .project-image {
    width: 100%;
    height: 250px;
    background-size: cover;
    background-position: center;
    transition: transform 0.5s ease;
  }

  .project-card:hover .project-image {
    transform: scale(1.05);
  }

  .project-content {
    padding: 1.5rem;
    background: var(--color-card-bg);
    border-top: 1px solid var(--color-border);
  }

  .project-title {
    font-size: 1.25rem;
    font-weight: 700;
    margin: 0 0 0.5rem 0;
    color: var(--color-text);
  }

  .project-description {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    margin: 0;
    line-height: 1.5;
  }

  .project-nav {
    display: flex;
    justify-content: center;
    gap: 1rem;
    margin-top: 2rem;
  }

  .project-nav-btn {
    background: var(--color-card-bg);
    border: 1px solid var(--color-border);
    color: var(--color-text);
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.3s ease;
    box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
  }

  .project-nav-btn:hover {
    background: var(--primary);
    color: white;
    transform: scale(1.1);
    border-color: var(--primary);
  }

  .project-nav-btn svg {
    pointer-events: none;
  }
</style>

<script>
  function initProjectCarousel() {
    const track = document.getElementById("project-track");
    const prevBtn = document.getElementById("project-prev");
    const nextBtn = document.getElementById("project-next");
    const cards = track?.querySelectorAll(".project-card");

    if (!track || !prevBtn || !nextBtn || !cards) return;

    // Intersection Observer for active state
    const observerOptions = {
      root: track,
      rootMargin: "0px -40% 0px -40%",
      threshold: 0.5,
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          cards.forEach((card) => card.classList.remove("active"));
          entry.target.classList.add("active");
        }
      });
    }, observerOptions);

    cards.forEach((card) => observer.observe(card));

    // Navigation buttons
    prevBtn.addEventListener("click", () => {
      const cardWidth = (cards[0] as HTMLElement).offsetWidth + 32; // card width + gap
      track.scrollBy({ left: -cardWidth, behavior: "smooth" });
    });

    nextBtn.addEventListener("click", () => {
      const cardWidth = (cards[0] as HTMLElement).offsetWidth + 32; // card width + gap
      track.scrollBy({ left: cardWidth, behavior: "smooth" });
    });
  }

  // Initialize on load
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initProjectCarousel);
  } else {
    initProjectCarousel();
  }

  // Re-initialize on Astro page transitions
  document.addEventListener("astro:page-load", initProjectCarousel);
</script>
