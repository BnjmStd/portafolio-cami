---
import RevitModeling from "~/icons/RevitModeling.astro";
import StructuralAnalysis from "~/icons/StructuralAnalysis.astro";
import ProjectManager from "~/icons/ProjectManager.astro";
import TechnicalReporting from "~/icons/TechnicalReporting.astro";
import SectionAndTitle from "./SectionAndTitle.astro";

const skills = [
    { icon: RevitModeling, name: "Revit Modeling" },
    { icon: StructuralAnalysis, name: "Structural Analysis" },
    { icon: ProjectManager, name: "Project Management" },
    { icon: TechnicalReporting, name: "Technical Reporting" },
];

// Duplicate array to create seamless loop
const marqueeSkills = [...skills, ...skills, ...skills];
---

<SectionAndTitle title="Core Skills">
    <div class="marquee-container">
        <!-- Decorative Graph Background -->
        <div class="graph-background">
            <svg
                viewBox="0 0 1200 200"
                preserveAspectRatio="none"
                class="graph-line"
            >
                <path
                    d="M0,100 C150,100 150,50 300,50 C450,50 450,150 600,150 C750,150 750,80 900,80 C1050,80 1050,120 1200,120"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    vector-effect="non-scaling-stroke"></path>
                <path
                    d="M0,100 C150,100 150,50 300,50 C450,50 450,150 600,150 C750,150 750,80 900,80 C1050,80 1050,120 1200,120 L1200,200 L0,200 Z"
                    fill="url(#gradient)"
                    opacity="0.1"></path>
                <defs>
                    <linearGradient
                        id="gradient"
                        x1="0%"
                        y1="0%"
                        x2="0%"
                        y2="100%"
                    >
                        <stop offset="0%" stop-color="currentColor"></stop>
                        <stop offset="100%" stop-color="transparent"></stop>
                    </linearGradient>
                </defs>
            </svg>
        </div>

        <!-- Marquee Content -->
        <div class="marquee-wrapper">
            <div class="marquee-track">
                {
                    marqueeSkills.map(({ icon: Icon, name }, index) => (
                        <div class="skill-card">
                            <div class="skill-icon">
                                <Icon />
                            </div>
                            <h3 class="skill-text">{name}</h3>
                        </div>
                    ))
                }
            </div>
        </div>
    </div>
</SectionAndTitle>

<style>
    .marquee-container {
        position: relative;
        width: 100%;
        overflow: hidden;
        padding: 4rem 0;
        /* Mask for fade edges */
        mask-image: linear-gradient(
            to right,
            transparent,
            black 10%,
            black 90%,
            transparent
        );
    }

    /* Graph Background */
    .graph-background {
        position: absolute;
        top: 50%;
        left: 0;
        width: 100%;
        height: 100%;
        transform: translateY(-50%);
        z-index: -1;
        opacity: 0.3;
        color: var(--primary);
    }

    .graph-line {
        width: 100%;
        height: 100%;
    }

    /* Marquee Animation */
    .marquee-wrapper {
        display: flex;
        width: 100%;
    }

    .marquee-track {
        display: flex;
        gap: 2rem;
        animation: scroll 30s linear infinite;
        width: max-content;
    }

    .marquee-track:hover {
        animation-play-state: paused;
    }

    @keyframes scroll {
        0% {
            transform: translateX(0);
        }
        100% {
            transform: translateX(
                -33.33%
            ); /* Move by 1/3 since we tripled the items */
        }
    }

    /* Skill Card */
    .skill-card {
        flex: 0 0 auto;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        width: 200px;
        height: 160px;
        background: var(--color-card-bg);
        border: 1px solid var(--color-border);
        border-radius: 1rem;
        box-shadow: 0 4px 6px var(--color-border);
        transition: all 0.3s ease;
        backdrop-filter: blur(8px);
    }

    .skill-card:hover {
        transform: translateY(-5px) scale(1.05);
        box-shadow: 0 10px 20px var(--color-border);
        border-color: var(--primary);
    }

    .skill-icon {
        width: 3.5rem;
        height: 3.5rem;
        margin-bottom: 1rem;
        color: var(--primary);
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(96, 122, 251, 0.1);
        border-radius: 50%;
        padding: 0.75rem;
    }

    .skill-text {
        font-size: 1rem;
        font-weight: 600;
        color: var(--color-text);
        text-align: center;
        margin: 0;
    }
</style>
