---
interface Props {
  variant?: "row" | "column";
  class?: string;
}

const { variant = "row", class: extraClass = "" } = Astro.props as Props;
---

<div class={`card card--${variant} ${extraClass}`}>
  <slot />
</div>

<style>
  .card {
    display: flex;
    align-items: center;
    border-radius: 0.75rem;
    border: 1px solid var(--color-border);
    background-color: var(--color-card-bg);
    box-shadow: 0 1px 2px var(--color-border);
    transition: all 0.3s ease-in-out;
  }

  .card--row {
    flex-direction: row;
    gap: 1rem;
    padding: 1rem;
  }

  .card--column {
    flex-direction: column;
    align-items: center;
    padding: 1rem;
    border: 1px solid rgba(59, 130, 246, 0.1);
  }

  @media (min-width: 640px) {
    .card--column {
      padding: 1.5rem;
    }
  }

  .card:hover,
  .card:focus {
    box-shadow: 0 6px 16px rgba(0, 0, 0, 0.15);
    border: 1px solid rgba(59, 130, 246, 0.3);
  }
</style>
