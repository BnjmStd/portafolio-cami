---
import ButtonDownloadCv from "./ButtonDownloadCv.astro";
import Menu from "~/icons/Menu.astro";
import Close from "~/icons/Close.astro";

const name = "Camila Aracena";
---

<header class="header">
  <div class="container">
    <a href="/" class="logo">{name}</a>

    <input type="checkbox" id="menu-toggle" class="menu-toggle" />
    <label for="menu-toggle" class="menu-button">
      <Menu />
    </label>

    <nav class="nav">
      <label for="menu-toggle" class="close-button">
        <Close />
      </label>
    </nav>
    <div class="header-actions">
      <button class="theme-toggle" id="theme-toggle" aria-label="Toggle theme">
        <svg
          class="sun-icon"
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          ><circle cx="12" cy="12" r="5"></circle><line
            x1="12"
            y1="1"
            x2="12"
            y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line><line
            x1="4.22"
            y1="4.22"
            x2="5.64"
            y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"
          ></line><line x1="1" y1="12" x2="3" y2="12"></line><line
            x1="21"
            y1="12"
            x2="23"
            y2="12"></line><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"
          ></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line></svg
        >
        <svg
          class="moon-icon"
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          ><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"
          ></path></svg
        >
      </button>
      <ButtonDownloadCv />
    </div>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 1000;
    background: var(--color-bg);
    box-shadow: 0 2px 4px var(--color-border);
    transition: background-color 0.3s ease;
  }

  .header svg {
    width: 24px;
    height: 24px;
    fill: var(--color-text);
    cursor: pointer;
  }

  .container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: 1200px;
    margin-inline: auto;
    padding: 0.75rem 1rem;
  }

  .logo {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-text);
    text-decoration: none;
  }

  .menu-toggle {
    display: none;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .menu-button,
  .close-button {
    display: none;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .theme-toggle {
    background: transparent;
    border: 1px solid var(--color-border);
    border-radius: 0.375rem;
    padding: 0.5rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s ease;
    color: var(--color-text);
  }

  .theme-toggle:hover {
    background: var(--color-card-bg);
    border-color: var(--primary);
  }

  .theme-toggle svg {
    width: 20px;
    height: 20px;
    stroke: currentColor;
  }

  .sun-icon {
    display: none;
  }

  :global([data-theme="light"]) .sun-icon {
    display: block;
  }

  :global([data-theme="light"]) .moon-icon {
    display: none;
  }

  :global([data-theme="dark"]) .sun-icon {
    display: none;
  }

  :global([data-theme="dark"]) .moon-icon {
    display: block;
  }

  @media (max-width: 768px) {
    .menu-button {
      display: block;
    }

    .nav {
      position: fixed;
      top: 0;
      right: -100%;
      height: 100vh;
      width: 220px;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      background: var(--color-bg);
      box-shadow: -5px 0 15px var(--color-border);
      transition: right 0.2s ease-in-out;
      gap: 2rem;
    }

    .close-button {
      display: block;
      position: absolute;
      top: 1rem;
      right: 1rem;
    }

    .menu-toggle:checked ~ .menu-button {
      display: none;
    }

    .menu-toggle:checked ~ .nav {
      right: 0;
    }
  }
</style>
